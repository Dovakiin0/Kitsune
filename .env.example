# PocketBase backend URL (user authentication, bookmarks, and watch history)
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# Optional: Redis connection URL for server caching (AniList queries & stream manifests)
# If omitted, Kitsune falls back to in-memory caching automatically.
REDIS_URL=redis://localhost:6379

# Optional: Kitsune Companion URL (defaults to http://127.0.0.1:43210 if running)
NEXT_PUBLIC_LOCAL_PROXY_URL=http://127.0.0.1:43210

# Optional: Public domain for production OpenGraph metadata
DOMAIN_URL=localhost:3000
NODE_ENV=development
